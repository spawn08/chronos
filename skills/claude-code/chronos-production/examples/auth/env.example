# Authentication (CHRONOS_AUTH: none (default) | jwt | apikey)
CHRONOS_AUTH=jwt
CHRONOS_JWT_SECRET=replace-with-random-32-char-minimum-secret
CHRONOS_JWT_ISSUER=chronos
CHRONOS_JWT_AUDIENCE=chronos-api
# No CHRONOS_JWT_EXPIRY: a JWT's expiry is the "exp" claim baked in at mint
# time (see `chronos auth token --ttl 24h`), not a server-side setting.

# API Keys — comma-separated "key:role:tenant" entries (role/tenant optional)
CHRONOS_API_KEYS=key-prod-replace-me:admin:default

# Authorization
CHRONOS_RBAC=true

# CORS
CHRONOS_CORS_ORIGINS=https://app.example.com

# Swagger (disable in production)
CHRONOS_SWAGGER=false

# Database
DATABASE_URL=postgres://chronos:password@localhost:5432/chronos?sslmode=require

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
