# Authentication
CHRONOS_AUTH=true
CHRONOS_JWT_SECRET=replace-with-random-32-char-minimum-secret
CHRONOS_JWT_ISSUER=chronos
CHRONOS_JWT_AUDIENCE=chronos-api
CHRONOS_JWT_EXPIRY=24h

# API Keys (comma-separated)
CHRONOS_API_KEYS=key-prod-replace-me

# Authorization
CHRONOS_RBAC=true

# CORS
CHRONOS_CORS_ORIGINS=https://app.example.com

# Swagger (disable in production)
CHRONOS_SWAGGER=false

# Database
DATABASE_URL=postgres://chronos:password@localhost:5432/chronos?sslmode=require

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
