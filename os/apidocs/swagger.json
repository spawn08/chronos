        "/api/traces": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Returns execution traces (spans) for a given session.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Traces"
                ],
                "summary": "List traces",
                "parameters": [
                    {
                        "type": "string",
