    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Static API key sent in the X-Api-Key header.",
            "type": "apiKey",
            "name": "X-Api-Key",
            "in": "header"
        },
        "BearerAuth": {
            "description": "JWT bearer token. Send as \"Authorization: Bearer \u003ctoken\u003e\".",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
