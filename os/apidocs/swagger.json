                    "application/json"
                ],
                "tags": [
                    "Schedules"
                ],
                "summary": "Get, delete, or get history of a schedule",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Schedule id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "schedule, deletion result, or history",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "GET returns a schedule; DELETE removes it; GET on the /history sub-path returns past runs.",
                "produces": [
                    "application/json"
                ],
                "tags": [
