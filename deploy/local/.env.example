# ──────────────────────────────────────────────────────────────
# Chronos — local development environment
#
#   cp .env.example .env
#   docker compose -f deploy/local/docker-compose.yml up -d --build
#
# Every value below has a local-dev default. Uncomment/edit to taste.
# ──────────────────────────────────────────────────────────────

# ── Storage backend ───────────────────────────────────────────
# One of: sqlite | postgres | redis. The server uses exactly ONE at a time.
# Default local stack = postgres (unlocks cross-replica scheduler + shared
# SQL rate limiter).
CHRONOS_STORAGE_BACKEND=postgres

# --- postgres backend (default) ---
# REQUIRED when CHRONOS_STORAGE_BACKEND=postgres.
CHRONOS_STORAGE_DSN=postgres://chronos:chronos@postgres:5432/chronos?sslmode=disable

# --- sqlite backend (single-node) ---
# Only used when CHRONOS_STORAGE_BACKEND=sqlite.
#CHRONOS_DB_PATH=chronos.db

# --- redis backend (ALTERNATIVE — storage only, no shared scheduler/limiter) ---
# To switch: run the stack with `--profile redis`, then set:
#CHRONOS_STORAGE_BACKEND=redis
#CHRONOS_REDIS_URL=redis://redis:6379/0

# Postgres container credentials (must match CHRONOS_STORAGE_DSN above).
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos
POSTGRES_DB=chronos

# ── Shared state (scheduler + rate limiter) ───────────────────
# postgres: ON by default (store-backed exactly-once cron across replicas +
#           cluster-wide SQL rate limiter). No need to set anything.
# sqlite:   single-node unless you force it on:
#CHRONOS_SHARED_STATE=true
# redis:    never gets the shared scheduler/limiter regardless of this value.

# ── Auth (opt-in — all optional) ──────────────────────────────
# Default is no auth for local dev.
CHRONOS_AUTH=none
#CHRONOS_RBAC=true
#CHRONOS_CORS_ORIGINS=http://localhost:3000

# --- JWT auth example ---
#CHRONOS_AUTH=jwt
#CHRONOS_JWT_SECRET=change-me-local-dev-secret
#CHRONOS_JWT_ISSUER=chronos-local
#CHRONOS_JWT_AUDIENCE=chronos
#CHRONOS_JWKS_URL=

# --- API-key auth example ---
# Format: "key:role:tenant,key:role:tenant,..."
#CHRONOS_AUTH=apikey
#CHRONOS_API_KEYS=local-dev-key:admin:default

# ── Swagger UI (served at /swagger/) ──────────────────────────
CHRONOS_SWAGGER=true

# ── Grafana admin (DEV ONLY) ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
