{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Chronos — Local (Golden Signals)",
  "uid": "chronos-local-golden",
  "tags": ["chronos", "local", "golden-signals"],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (RPS) by code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(chronos_http_requests_total[1m])) by (code)",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx ratio)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 0.05 } },
      "targets": [
        {
          "expr": "sum(rate(chronos_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(chronos_http_requests_total[5m])), 1)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(chronos_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chronos_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(chronos_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler due backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "chronos_scheduler_due_backlog",
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "go_goroutines{job=\"chronos\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go heap in use",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"chronos\"}",
          "legendFormat": "heap in use"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go GC pause rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_sum{job=\"chronos\"}[5m])",
          "legendFormat": "gc pause/s"
        }
      ]
    }
  ]
}
